# Used by `npm run dev` only. Points the UI at the local API (cd api && uv run uvicorn app.main:app --port 8000).
VITE_API_BASE=http://localhost:8000/v1
# Mocked sign-in tokens (dev auth). Change to view as another sample user, e.g. dev-resident-b or dev-vendor-taco.
VITE_DEV_TOKEN_RESIDENT=dev-resident-a
VITE_DEV_TOKEN_VENDOR=dev-vendor-icecream
VITE_DEV_TOKEN_VILLAGE=dev-reviewer
